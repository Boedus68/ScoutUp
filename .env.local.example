# Copia questo file in .env.local e inserisci i valori del tuo progetto Supabase.
# Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Origine pubblica per link di invito/recovery (redirectTo).
NEXT_PUBLIC_SITE_URL=https://scout-up.it

# Opzionale — solo server (Netlify / env host). MAI NEXT_PUBLIC_ / browser.
# Abilita «Invita capo» via Auth Admin (inviteUserByEmail).
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
